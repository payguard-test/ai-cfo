# Copy to .env. Never commit .env.
BUSINESS_NAME=Demo Foods Ltd
CURRENCY=NGN
DB_PATH=data/ai_cfo.db
INGEST_API_KEY=dev-ingest-key

# NEAR AI Cloud (https://cloud.near.ai). Empty = keyword rules only.
NEAR_AI_API_KEY=
NEAR_AI_MODEL=Qwen/Qwen3.8-27B
NEAR_AI_VERIFY=true
REVIEW_THRESHOLD=0.75

# Telegram: create a bot with @BotFather, then run: python -m app.telegram chat-id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional real mailbox (Gmail app password). Read-only; only these senders are read.
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_SENDER_ALLOWLIST=

# NEAR testnet. OWNER_* is only used once by: npm --prefix near run setup
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
OWNER_ACCOUNT_ID=
OWNER_PRIVATE_KEY=
# Filled in by near/setup.mjs:
BOOKS_CONTRACT_ID=
